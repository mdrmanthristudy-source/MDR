<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>APPSC OS V2</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://www.gstatic.com/charts/loader.js"></script>
  <style>
    .tab-content { display: none; }
    .tab-content.active { display: block; }
    ::-webkit-scrollbar { width: 5px; height: 5px; }
    ::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 4px; }
  </style>
</head>
<body class="bg-slate-100 text-slate-800 font-sans min-h-screen flex flex-col antialiased">

  <!-- TOP APP BAR -->
  <header class="bg-slate-900 border-b border-slate-800 px-6 py-3 flex justify-between items-center sticky top-0 z-50 text-white">
    <div class="flex items-center space-x-3">
      <span class="bg-indigo-600 px-2.5 py-1 rounded text-xs font-black tracking-widest uppercase">APPSC</span>
      <h1 class="text-sm font-bold tracking-wide">Digital Prep Engine V2</h1>
    </div>
    <div class="flex items-center gap-3">
      <div id="streak-pill" class="text-xs bg-slate-800 px-3 py-1 rounded-full border border-slate-700 font-medium">🔥 Streak: <strong id="top-streak" class="text-indigo-400">0 Days</strong></div>
      <div class="flex items-center gap-2">
        <input type="password" id="global-api-key" placeholder="Gemini API Key..." class="bg-slate-800 border border-slate-700 rounded px-3 py-1 text-xs text-white focus:outline-none focus:border-indigo-500 w-48">
        <button onclick="saveGlobalKey()" class="bg-indigo-600 hover:bg-indigo-500 text-white px-3 py-1 rounded text-xs font-bold transition shadow">Save</button>
      </div>
    </div>
  </header>

  <div class="flex-1 flex overflow-hidden">
    <!-- SIDEBAR NAV -->
    <aside class="w-64 bg-white border-r border-slate-200 p-3 flex flex-col shrink-0 overflow-y-auto">
      <nav class="space-y-1">
        <button onclick="switchTab('telemetry')" class="nav-btn w-full flex items-center space-x-3 px-3 py-2.5 rounded-lg text-xs font-semibold bg-indigo-50 text-indigo-700" data-tab="telemetry"><span>📊</span> <span>Telemetry Hub</span></button>
        <button onclick="switchTab('arena')" class="nav-btn w-full flex items-center space-x-3 px-3 py-2.5 rounded-lg text-xs font-medium text-slate-600 hover:bg-slate-50" data-tab="arena"><span>🎯</span> <span>Test Arena & Engine</span></button>
        <button onclick="switchTab('pyq')" class="nav-btn w-full flex items-center space-x-3 px-3 py-2.5 rounded-lg text-xs font-medium text-slate-600 hover:bg-slate-50" data-tab="pyq"><span>📥</span> <span>Bulk Ingestion & Vault</span></button>
        <button onclick="switchTab('strategy')" class="nav-btn w-full flex items-center space-x-3 px-3 py-2.5 rounded-lg text-xs font-medium text-slate-600 hover:bg-slate-50" data-tab="strategy"><span>🧠</span> <span>AI Strategy Room</span></button>
        <button onclick="switchTab('mains')" class="nav-btn w-full flex items-center space-x-3 px-3 py-2.5 rounded-lg text-xs font-medium text-slate-600 hover:bg-slate-50" data-tab="mains"><span>✍️</span> <span>Mains Evaluator</span></button>
        <button onclick="switchTab('library')" class="nav-btn w-full flex items-center space-x-3 px-3 py-2.5 rounded-lg text-xs font-medium text-slate-600 hover:bg-slate-50" data-tab="library"><span>📚</span> <span>Digital Study Desk</span></button>
      </nav>
      <div class="mt-auto p-3 bg-slate-50 rounded-lg border border-slate-200 text-center">
        <span class="text-[10px] text-slate-400 font-bold uppercase tracking-wider">Engine Core</span>
        <div class="text-xs font-bold text-slate-700 mt-0.5">Gemini 3.6 Flash Active</div>
      </div>
    </aside>

    <main class="flex-1 overflow-y-auto p-6">

      <!-- 1. TELEMETRY HUB -->
      <section id="telemetry" class="tab-content active max-w-6xl mx-auto space-y-6">
        <div class="flex justify-between items-center">
          <div><h2 class="text-xl font-black text-slate-900">Executive Command Center</h2><p class="text-xs text-slate-500">Live telemetry, spaced repetition debt, and official board releases.</p></div>
          <button onclick="loadTelemetryDashboard()" class="text-xs bg-white border border-slate-300 px-3 py-1.5 rounded-md hover:bg-slate-50 font-semibold shadow-sm">🔄 Recalculate Metrics</button>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
          <div class="bg-white p-4 rounded-xl border border-slate-200 shadow-sm flex flex-col justify-between">
            <span class="text-[10px] font-bold text-slate-400 uppercase">Daily Target Velocity</span>
            <div class="text-3xl font-black text-indigo-600 mt-2" id="vel-text">0 / 50</div>
            <div class="w-full bg-slate-100 h-1.5 rounded-full mt-3 overflow-hidden"><div id="vel-bar" class="bg-indigo-600 h-full w-0"></div></div>
          </div>
          <div class="bg-white p-4 rounded-xl border border-slate-200 shadow-sm flex flex-col justify-between">
            <span class="text-[10px] font-bold text-slate-400 uppercase">Spaced Retention Debt</span>
            <div class="flex items-baseline gap-2 mt-2"><span class="text-3xl font-black text-amber-600" id="debt-due">0</span><span class="text-xs text-slate-400">Due</span><span class="text-3xl font-black text-rose-600 ml-2" id="debt-overdue">0</span><span class="text-xs text-slate-400">Overdue</span></div>
            <span class="text-[10px] text-slate-400 mt-3">Next iteration due: Day 3 & 7</span>
          </div>
          <div class="col-span-2 bg-white p-4 rounded-xl border border-slate-200 shadow-sm flex flex-col justify-between">
            <div class="flex justify-between items-center mb-1"><span class="text-[10px] font-bold text-indigo-600 uppercase">APPSC Official Wire & Board Monitor</span><span class="text-[9px] bg-indigo-50 text-indigo-700 px-2 py-0.5 rounded font-bold">Live RSS Feed</span></div>
            <div id="board-wire-list" class="space-y-1.5 overflow-y-auto max-h-20 text-xs text-slate-600">Loading verified updates...</div>
          </div>
        </div>

        <!-- 6D Chart Grid -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
          <div class="bg-white p-4 rounded-xl border border-slate-200 shadow-sm"><h3 class="text-xs font-bold text-slate-700 mb-3 border-b pb-2">Net Score Trajectory</h3><div id="chart-trend" class="h-60 w-full"></div></div>
          <div class="bg-white p-4 rounded-xl border border-slate-200 shadow-sm"><h3 class="text-xs font-bold text-slate-700 mb-3 border-b pb-2">The Penalty Tax (-0.33 Deduction Impact)</h3><div id="chart-penalty" class="h-60 w-full"></div></div>
          <div class="bg-white p-4 rounded-xl border border-slate-200 shadow-sm"><h3 class="text-xs font-bold text-slate-700 mb-3 border-b pb-2">Decision Risk Profile</h3><div id="chart-risk" class="h-60 w-full"></div></div>
          <div class="bg-white p-4 rounded-xl border border-slate-200 shadow-sm"><h3 class="text-xs font-bold text-slate-700 mb-3 border-b pb-2">Subject Accuracy Breakdown</h3><div id="chart-subjects" class="h-60 w-full"></div></div>
          <div class="bg-white p-4 rounded-xl border border-slate-200 shadow-sm"><h3 class="text-xs font-bold text-slate-700 mb-3 border-b pb-2">Time Consumed by Question Difficulty (Seconds)</h3><div id="chart-diff-speed" class="h-60 w-full"></div></div>
          <div class="bg-white p-4 rounded-xl border border-slate-200 shadow-sm"><h3 class="text-xs font-bold text-slate-700 mb-3 border-b pb-2">Top 5 Slowest Micro-Topics</h3><div id="chart-topic-speed" class="h-60 w-full"></div></div>
        </div>
      </section>

      <!-- 2. TEST ARENA & ENGINE -->
      <section id="arena" class="tab-content max-w-4xl mx-auto space-y-6">
        <div id="arena-config" class="bg-white p-6 rounded-xl border border-slate-200 shadow-sm space-y-4">
          <h2 class="text-lg font-black text-slate-900 border-b pb-3">Test Engine Configurator</h2>
          <div class="grid grid-cols-2 gap-4">
            <div>
              <label class="text-xs font-bold text-slate-600 block mb-1">Target Subject / Topic</label>
              <input type="text" id="test-topic" placeholder="e.g. Satavahana Economy, 73rd Amendment, AP Bifurcation..." class="w-full border rounded-lg px-3 py-2 text-xs bg-slate-50 focus:outline-none focus:border-indigo-500">
            </div>
            <div>
              <label class="text-xs font-bold text-slate-600 block mb-1">Difficulty Tier</label>
              <select id="test-tier" class="w-full border rounded-lg px-3 py-2 text-xs bg-slate-50 focus:outline-none">
                <option value="Group 2 Standard (Factual & Direct)">Group 2 Standard (Statutory & Schemes)</option>
                <option value="Group 1 Standard (Analytical/Multi-Statement)">Group 1 Standard (Analytical & Complex)</option>
                <option value="Hybrid Blend">Hybrid Blend</option>
              </select>
            </div>
          </div>
          <div class="flex gap-4">
            <button onclick="launchStandardTest()" class="flex-1 bg-indigo-600 hover:bg-indigo-700 text-white font-bold py-3 rounded-lg text-xs shadow transition">🚀 Launch Standard Test</button>
            <button onclick="launchFlaggedReview()" class="flex-1 bg-rose-600 hover:bg-rose-700 text-white font-bold py-3 rounded-lg text-xs shadow transition">🚩 Launch Flagged Queue Review</button>
          </div>
        </div>

        <div id="arena-loader" class="hidden text-center py-20"><div class="animate-spin h-8 w-8 border-4 border-indigo-600 border-t-transparent rounded-full mx-auto mb-3"></div><p class="text-xs text-slate-500 font-bold">Synthesizing Questions with Gemini 3.6 Flash...</p></div>

        <!-- The Live Test Environment -->
        <div id="arena-runner" class="hidden space-y-4">
          <div class="bg-white p-4 rounded-xl border border-slate-200 shadow-sm flex justify-between items-center">
            <div><span class="text-xs font-bold text-indigo-700" id="q-counter">Question 1 of 5</span><span class="text-[10px] bg-slate-100 text-slate-500 px-2 py-0.5 rounded ml-2" id="q-tier-badge">Standard</span></div>
            <div class="flex items-center gap-3"><span class="text-xs font-mono font-bold text-slate-600" id="stopwatch-display">⏱️ 0s</span><button onclick="flagCurrentQuestion()" class="text-xs border border-rose-200 text-rose-600 bg-rose-50 px-3 py-1 rounded-md hover:bg-rose-100 font-semibold">🚩 Flag</button></div>
          </div>
          <div class="bg-white p-6 rounded-xl border border-slate-200 shadow-sm">
            <h3 id="runner-q-text" class="text-sm font-semibold text-slate-900 leading-relaxed mb-6"></h3>
            <div id="runner-options" class="space-y-2 mb-6"></div>
            <div id="runner-explanation" class="hidden p-4 bg-slate-50 border-l-4 border-indigo-600 rounded text-xs space-y-2 mb-4 leading-relaxed"></div>
            <div class="flex justify-between items-center pt-2">
              <button onclick="toggleTutorChat()" class="text-xs text-indigo-600 font-bold hover:underline">✨ Discuss with Gemini 3.6 Flash</button>
              <button id="btn-next-q" onclick="handleNextQuestion()" class="bg-slate-900 hover:bg-black text-white font-bold px-6 py-2 rounded-lg text-xs transition" disabled>Next Question</button>
            </div>
            <!-- Tutor Drawer -->
            <div id="tutor-drawer" class="hidden mt-4 pt-4 border-t space-y-2">
              <div id="tutor-chat-history" class="max-h-40 overflow-y-auto space-y-2 text-xs"></div>
              <div class="flex gap-2"><input type="text" id="tutor-query" placeholder="Ask specific clarification..." class="flex-1 border rounded px-3 py-1.5 text-xs focus:outline-none"><button onclick="askTutorInline()" class="bg-indigo-600 text-white font-bold px-3 py-1.5 rounded text-xs">Send</button></div>
            </div>
          </div>
        </div>

        <div id="arena-results" class="hidden bg-white p-8 rounded-xl border border-slate-200 text-center space-y-4">
          <h3 class="text-xl font-black text-slate-900">Attempt Evaluated</h3>
          <p id="arena-score-readout" class="text-sm text-slate-600 leading-relaxed whitespace-pre-line"></p>
          <button onclick="exitArena()" class="bg-indigo-600 text-white font-bold px-6 py-2 rounded-lg text-xs">Back to Arena Setup</button>
        </div>
      </section>

      <!-- 3. BULK INGESTION & VAULT -->
      <section id="pyq" class="tab-content max-w-4xl mx-auto space-y-6">
        <div class="bg-white p-6 rounded-xl border border-slate-200 shadow-sm space-y-4">
          <h2 class="text-lg font-black text-slate-900">PYQ & Question JSON Importer</h2>
          <p class="text-xs text-slate-500">Paste your structured JSON array of MCQs generated from exam papers or mock drafts. The backend writes directly to `PYQ_Repository` in bulk.</p>
          <textarea id="bulk-json-input" rows="8" placeholder='[{"question":"Who founded the Satavahana dynasty?","optionA":"Simuka","optionB":"Satakarni I","optionC":"Gautamiputra","optionD":"Yajna Sri","correctOption":"A","microTopic":"Ancient AP","difficulty":"Easy","examTag":"APPSC Gr2 2019"}]' class="w-full border rounded-lg p-3 text-xs font-mono bg-slate-50 focus:outline-none"></textarea>
          <button onclick="executeBulkImport()" class="w-full bg-slate-900 hover:bg-black text-white font-bold py-3 rounded-lg text-xs transition">Ingest Batch into Master Repository</button>
        </div>

        <div class="bg-white rounded-xl border border-slate-200 shadow-sm overflow-hidden">
          <div class="p-4 border-b flex justify-between items-center"><h3 class="text-xs font-bold text-slate-800">Master Question Archive</h3><span id="pyq-bank-count" class="text-xs font-bold text-indigo-600 bg-indigo-50 px-2 py-0.5 rounded">0 Banked</span></div>
          <div id="pyq-archive-list" class="divide-y max-h-72 overflow-y-auto"></div>
        </div>
      </section>

      <!-- 4. AI STRATEGY ROOM -->
      <section id="strategy" class="tab-content max-w-4xl mx-auto h-[75vh]">
        <div class="h-full flex flex-col bg-white border border-slate-200 rounded-xl shadow-sm overflow-hidden">
          <div class="p-4 border-b bg-slate-50 flex justify-between items-center"><h3 class="text-sm font-bold text-slate-800">AI Strategist & Syllabus Scheduler</h3><span class="text-[10px] text-slate-500">Zero Execution Timeouts (Direct Client-Side)</span></div>
          <div id="strat-chat" class="flex-1 overflow-y-auto p-4 space-y-3 text-xs"></div>
          <div class="p-3 border-t bg-slate-50 flex gap-2"><input type="text" id="strat-input" placeholder="e.g. Schedule a 5-day blitz on AP Bifurcation economics..." class="flex-1 border rounded px-3 py-2 text-xs focus:outline-none"><button onclick="executeStrategyChat()" class="bg-indigo-600 hover:bg-indigo-700 text-white font-bold px-4 py-2 rounded text-xs">Generate</button></div>
        </div>
      </section>

      <!-- 5. MAINS EVALUATOR -->
      <section id="mains" class="tab-content max-w-4xl mx-auto space-y-4">
        <div class="bg-white p-6 rounded-xl border border-slate-200 shadow-sm space-y-4">
          <h2 class="text-lg font-black text-slate-900">Group 1 Mains Evaluator</h2>
          <div><label class="text-xs font-bold text-slate-600 block mb-1">Question Prompt</label><input type="text" id="mains-prompt" placeholder="Paste the Mains question..." class="w-full border rounded-lg p-2.5 text-xs bg-slate-50 focus:outline-none"></div>
          <div><label class="text-xs font-bold text-slate-600 block mb-1">Submitted Answer</label><textarea id="mains-answer" rows="9" placeholder="Type or paste your answer..." class="w-full border rounded-lg p-3 text-xs bg-slate-50 focus:outline-none"></textarea></div>
          <button onclick="evaluateMainsSubmission()" class="w-full bg-indigo-600 hover:bg-indigo-700 text-white font-bold py-3 rounded-lg text-xs transition">Grade Answer (Strict Group 1 Rubric)</button>
        </div>
        <div id="mains-feedback-box" class="hidden bg-white p-6 rounded-xl border border-slate-200 shadow-sm text-xs space-y-3 leading-relaxed"></div>
      </section>

      <!-- 6. DIGITAL STUDY DESK -->
      <section id="library" class="tab-content max-w-5xl mx-auto space-y-4">
        <div class="flex justify-between items-center bg-white p-4 rounded-xl border border-slate-200 shadow-sm">
          <div><h3 class="text-sm font-bold text-slate-800">Drive PDF Archive</h3><p class="text-xs text-slate-500">Synced directly with `APPSC_Study_Library` in Google Drive.</p></div>
          <button onclick="syncDriveLibrary()" class="bg-slate-900 text-white px-3 py-1.5 rounded text-xs font-bold hover:bg-black">🔄 Refresh Archive</button>
        </div>
        <div id="book-catalog-grid" class="grid grid-cols-1 md:grid-cols-3 gap-3"></div>
      </section>

    </main>
  </div>

  <script>
    google.charts.load('current', {'packages':['corechart', 'bar']});

    window.myApiKey = "";
    window.activeQuestions = [];
    window.currentQIndex = 0;
    window.userScore = 0;
    window.selectedOption = null;
    window.stopwatchTimer = null;
    window.secondsCounter = 0;
    window.lastQuestionStartTime = 0;

    function switchTab(tabId) {
      document.querySelectorAll('.tab-content').forEach(el => el.classList.remove('active'));
      document.querySelectorAll('.nav-btn').forEach(btn => {
        btn.classList.remove('bg-indigo-50', 'text-indigo-700');
        btn.classList.add('text-slate-600');
      });
      document.getElementById(tabId).classList.add('active');
      const activeBtn = document.querySelector(`[data-tab="${tabId}"]`);
      if (activeBtn) {
        activeBtn.classList.remove('text-slate-600');
        activeBtn.classList.add('bg-indigo-50', 'text-indigo-700');
      }
      if (tabId === 'telemetry') loadTelemetryDashboard();
      if (tabId === 'pyq') loadPYQArchive();
      if (tabId === 'library') syncDriveLibrary();
    }

    function saveGlobalKey() {
      const k = document.getElementById('global-api-key').value.trim();
      if (!k) return alert("Enter key first.");
      window.myApiKey = k;
      google.script.run.withSuccessHandler(() => alert("✅ Gemini Key Locked Successfully.")).saveKeyToBackend(k);
    }

    function parseMarkdown(text) {
      if (!text) return "";
      let html = text.replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>');
      html = html.replace(/\n\* (.*?)/g, '<li class="ml-4 list-disc mt-1">$1</li>');
      html = html.replace(/\n/g, '<br>');
      return html;
    }

    // BOOT SEQUENCE
    window.onload = function() {
      google.script.run.withSuccessHandler(key => {
        if (key) {
          window.myApiKey = key;
          document.getElementById('global-api-key').value = key;
        }
      }).getClientApiKey();

      loadTelemetryDashboard();
      loadBoardWire();
    };

    function loadBoardWire() {
      google.script.run.withSuccessHandler(items => {
        document.getElementById('board-wire-list').innerHTML = items.map(i => `
          <div class="flex justify-between items-center py-1 border-b border-slate-100">
            <a href="${i.link}" target="_blank" class="font-medium text-indigo-700 hover:underline truncate pr-2">${i.title}</a>
            <span class="text-[9px] text-slate-400 shrink-0">${i.source}</span>
          </div>`).join('');
      }).fetchOfficialBoardWire();
    }

    function loadTelemetryDashboard() {
      google.script.run.withSuccessHandler(data => {
        if (!data) return;
        document.getElementById('vel-text').innerText = `${data.velocity.completed} / 50`;
        document.getElementById('vel-bar').style.width = `${data.velocity.percent}%`;
        document.getElementById('debt-due').innerText = data.debt.due;
        document.getElementById('debt-overdue').innerText = data.debt.overdue;
        document.getElementById('top-streak').innerText = `${data.streak} Days`;

        // Render Google Charts
        new google.visualization.LineChart(document.getElementById('chart-trend')).draw(
          google.visualization.arrayToDataTable(data.trend), { legend: 'none', colors: ['#4f46e5'], chartArea: { width: '85%', height: '75%' } }
        );
        new google.visualization.AreaChart(document.getElementById('chart-penalty')).draw(
          google.visualization.arrayToDataTable(data.penalty), { colors: ['#16a34a', '#dc2626'], chartArea: { width: '85%', height: '75%' }, legend: { position: 'bottom' } }
        );
        new google.visualization.PieChart(document.getElementById('chart-risk')).draw(
          google.visualization.arrayToDataTable(data.risk), { pieHole: 0.4, colors: ['#16a34a', '#dc2626', '#94a3b8'], chartArea: { width: '90%', height: '80%' } }
        );
        new google.visualization.ColumnChart(document.getElementById('chart-subjects')).draw(
          google.visualization.arrayToDataTable(data.subjects), { isStacked: true, colors: ['#16a34a', '#dc2626'], chartArea: { width: '85%', height: '70%' }, legend: { position: 'bottom' } }
        );
        new google.visualization.ColumnChart(document.getElementById('chart-diff-speed')).draw(
          google.visualization.arrayToDataTable(data.diffSpeed), { legend: 'none', colors: ['#0284c7'], chartArea: { width: '85%', height: '70%' } }
        );
        new google.visualization.BarChart(document.getElementById('chart-topic-speed')).draw(
          google.visualization.arrayToDataTable(data.topicSpeed), { legend: 'none', colors: ['#7c3aed'], chartArea: { width: '70%', height: '80%' } }
        );
      }).getAdvancedAnalytics();
    }

    // ARENA EXECUTION (CLIENT-SIDE GEMINI 3.6 FLASH)
    async function launchStandardTest() {
      const topic = document.getElementById('test-topic').value.trim() || "APPSC General Studies Mixed";
      const tier = document.getElementById('test-tier').value;
      if (!window.myApiKey) return alert("Save your Gemini API Key first.");

      document.getElementById('arena-config').classList.add('hidden');
      document.getElementById('arena-loader').classList.remove('hidden');

      const sysPrompt = `Generate 5 multiple choice questions for the APPSC examination. Topic: "${topic}". Difficulty: ${tier}. Ensure verified accuracy.`;
      const schema = {
        type: "ARRAY",
        items: {
          type: "OBJECT",
          properties: {
            question: { type: "STRING" },
            optionA: { type: "STRING" },
            optionB: { type: "STRING" },
            optionC: { type: "STRING" },
            optionD: { type: "STRING" },
            correctOption: { type: "STRING" },
            explanation: { type: "STRING" },
            microTopic: { type: "STRING" },
            difficulty: { type: "STRING" }
          },
          required: ["question", "optionA", "optionB", "optionC", "optionD", "correctOption", "explanation", "microTopic", "difficulty"]
        }
      };

      try {
        const response = await fetch(`https://generativelanguage.googleapis.com/v1beta/models/gemini-3.6-flash:generateContent?key=${window.myApiKey}`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ contents: [{ parts: [{ text: sysPrompt }] }], generationConfig: { responseMimeType: "application/json", responseSchema: schema } })
        });
        const d = await response.json();
        document.getElementById('arena-loader').classList.add('hidden');
        if (d.error) throw new Error(d.error.message);

        window.activeQuestions = JSON.parse(d.candidates[0].content.parts[0].text);
        window.currentQIndex = 0;
        window.userScore = 0;
        renderQuestionRunner();
      } catch (e) {
        document.getElementById('arena-loader').classList.add('hidden');
        document.getElementById('arena-config').classList.remove('hidden');
        alert("Generation Error: " + e.message);
      }
    }

    function renderQuestionRunner() {
      window.selectedOption = null;
      document.getElementById('btn-next-q').disabled = true;
      document.getElementById('runner-explanation').classList.add('hidden');
      document.getElementById('tutor-drawer').classList.add('hidden');
      document.getElementById('arena-runner').classList.remove('hidden');

      const q = window.activeQuestions[window.currentQIndex];
      document.getElementById('q-counter').innerText = `Question ${window.currentQIndex + 1} of ${window.activeQuestions.length}`;
      document.getElementById('q-tier-badge').innerText = q.difficulty || "Standard";
      document.getElementById('runner-q-text').innerText = q.question;

      document.getElementById('runner-options').innerHTML = ['A', 'B', 'C', 'D'].map(opt => `
        <div onclick="selectRunnerOption('${opt}')" id="opt-${opt}" class="p-3 border rounded-lg text-xs hover:bg-slate-50 cursor-pointer flex items-center transition">
          <span class="font-bold mr-2 text-slate-700">${opt})</span> <span>${q['option' + opt]}</span>
        </div>`).join('');

      // Silent Stopwatch Trigger
      window.secondsCounter = 0;
      clearInterval(window.stopwatchTimer);
      window.stopwatchTimer = setInterval(() => {
        window.secondsCounter++;
        document.getElementById('stopwatch-display').innerText = `⏱️ ${window.secondsCounter}s`;
      }, 1000);
      window.lastQuestionStartTime = Date.now();
    }

    function selectRunnerOption(opt) {
      if (window.selectedOption) return;
      window.selectedOption = opt;
      clearInterval(window.stopwatchTimer);
      document.getElementById('btn-next-q').disabled = false;

      const q = window.activeQuestions[window.currentQIndex];
      const isCorrect = (opt === q.correctOption);
      const spent = Math.min(180, Math.round((Date.now() - window.lastQuestionStartTime) / 1000));

      q.timeTaken = spent;
      q.selectedOption = opt;
      q.selected = true;
      q.isCorrect = isCorrect;
      q.rawQuestion = q;

      if (isCorrect) {
        window.userScore++;
        document.getElementById(`opt-${opt}`).classList.add('bg-emerald-100', 'border-emerald-500', 'text-emerald-900', 'font-bold');
      } else {
        document.getElementById(`opt-${opt}`).classList.add('bg-rose-100', 'border-rose-500', 'text-rose-900');
        document.getElementById(`opt-${q.correctOption}`).classList.add('bg-emerald-100', 'border-emerald-500', 'text-emerald-900', 'font-bold');
      }

      const exp = document.getElementById('runner-explanation');
      exp.classList.remove('hidden');
      exp.innerHTML = `<strong>Explanation:</strong> ${q.explanation}`;
    }

    function handleNextQuestion() {
      window.currentQIndex++;
      if (window.currentQIndex < window.activeQuestions.length) {
        renderQuestionRunner();
      } else {
        document.getElementById('arena-runner').classList.add('hidden');
        document.getElementById('arena-results').classList.remove('hidden');

        const gross = window.userScore;
        const wrong = window.activeQuestions.length - gross;
        const net = (gross * 1) - (wrong * 0.333);

        document.getElementById('arena-score-readout').innerText =
          `Raw Score: ${gross} / ${window.activeQuestions.length}\nPenalty Deduction: -${(wrong * 0.333).toFixed(2)}\nNet Score: ${net.toFixed(2)}\n\nSaving results to database...`;

        const scope = document.getElementById('test-topic').value || "Mixed Studies";
        google.script.run.withSuccessHandler(() => {
          document.getElementById('arena-score-readout').innerText += `\n✅ Attempt fully synced to Objective_Scores, Error_Log & TPQ_Analytics.`;
        }).logExamResults(window.activeQuestions, net.toFixed(2), scope);
      }
    }

    function exitArena() {
      document.getElementById('arena-results').classList.add('hidden');
      document.getElementById('arena-config').classList.remove('hidden');
      loadTelemetryDashboard();
    }

    function flagCurrentQuestion() {
      const q = window.activeQuestions[window.currentQIndex];
      google.script.run.withSuccessHandler(() => alert("🚩 Question saved to Review Queue.")).flagQuestionForReview(
        "General", q.microTopic || "Topic", q.question, JSON.stringify(q)
      );
    }

    function toggleTutorChat() {
      document.getElementById('tutor-drawer').classList.toggle('hidden');
    }

    async function askTutorInline() {
      const u = document.getElementById('tutor-query').value.trim();
      if (!u || !window.myApiKey) return;
      const q = window.activeQuestions[window.currentQIndex];
      const history = document.getElementById('tutor-chat-history');
      history.innerHTML += `<div class="text-right text-indigo-700 font-medium">You: ${u}</div>`;
      document.getElementById('tutor-query').value = "";

      const prompt = `APPSC Tutor. Context Question: "${q.question}" Correct: ${q.correctOption}. Explanation: ${q.explanation}. Student doubt: "${u}". Respond concisely.`;
      const res = await fetch(`https://generativelanguage.googleapis.com/v1beta/models/gemini-3.6-flash:generateContent?key=${window.myApiKey}`, {
        method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ contents: [{ parts: [{ text: prompt }] }] })
      });
      const d = await res.json();
      history.innerHTML += `<div class="bg-slate-100 p-2 rounded text-slate-800">Tutor: ${parseMarkdown(d.candidates[0].content.parts[0].text)}</div>`;
    }

    // BULK IMPORTER
    function executeBulkImport() {
      const raw = document.getElementById('bulk-json-input').value.trim();
      if (!raw) return alert("Paste JSON string first.");
      google.script.run.withSuccessHandler(r => {
        if (r.error) alert(r.error);
        else {
          alert(`✅ Ingested ${r.count} PYQs into Repository.`);
          document.getElementById('bulk-json-input').value = "";
          loadPYQArchive();
        }
      }).importBulkPYQs(raw);
    }

    function loadPYQArchive() {
      google.script.run.withSuccessHandler(res => {
        document.getElementById('pyq-bank-count').innerText = `${res.count} Banked`;
        document.getElementById('pyq-archive-list').innerHTML = res.items.map(i => `
          <div class="p-3 hover:bg-slate-50 text-xs">
            <div class="flex justify-between items-center text-[10px] text-slate-400 mb-1"><span>${i.tag}</span><span class="bg-slate-100 px-1.5 py-0.5 rounded text-slate-600">${i.topic}</span></div>
            <p class="font-medium text-slate-800 leading-snug">${i.question}</p>
          </div>`).join('');
      }).fetchPYQArchive();
    }

    // STRATEGY ENGINE
    async function executeStrategyChat() {
      const q = document.getElementById('strat-input').value.trim();
      if (!q || !window.myApiKey) return alert("Save Gemini key and type a request.");
      const chat = document.getElementById('strat-chat');
      chat.innerHTML += `<div class="bg-indigo-50 border border-indigo-100 p-3 rounded-lg text-indigo-900 font-medium ml-12 text-right">${q}</div>`;
      document.getElementById('strat-input').value = "";

      const res = await fetch(`https://generativelanguage.googleapis.com/v1beta/models/gemini-3.6-flash:generateContent?key=${window.myApiKey}`, {
        method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ contents: [{ parts: [{ text: `Act as an elite APPSC strategist. Format in Markdown. Prompt: ${q}` }] }] })
      });
      const d = await res.json();
      chat.innerHTML += `<div class="bg-white border p-4 rounded-lg mr-12 text-slate-800 shadow-sm leading-relaxed">${parseMarkdown(d.candidates[0].content.parts[0].text)}</div>`;
    }

    // MAINS EVALUATOR
    async function evaluateMainsSubmission() {
      const p = document.getElementById('mains-prompt').value.trim();
      const a = document.getElementById('mains-answer').value.trim();
      if (!p || !a || !window.myApiKey) return alert("Complete fields and ensure key is saved.");

      const box = document.getElementById('mains-feedback-box');
      box.classList.remove('hidden');
      box.innerHTML = "<em>Analyzing structure, factual density, and APPSC rubric alignment...</em>";

      const prompt = `Grade this Group 1 Mains answer out of 10. Question: "${p}". Answer: """${a}""". Provide: Score, Presentation feedback, Data points to incorporate, and Model Conclusion. Markdown.`;
      const res = await fetch(`https://generativelanguage.googleapis.com/v1beta/models/gemini-3.6-flash:generateContent?key=${window.myApiKey}`, {
        method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ contents: [{ parts: [{ text: prompt }] }] })
      });
      const d = await res.json();
      box.innerHTML = parseMarkdown(d.candidates[0].content.parts[0].text);
    }

    // DRIVE LIBRARY
    function syncDriveLibrary() {
      google.script.run.withSuccessHandler(books => {
        const grid = document.getElementById('book-catalog-grid');
        if (!books.length) {
          grid.innerHTML = `<div class="col-span-3 text-center text-xs text-slate-400 py-10">Upload PDFs to 'APPSC_Study_Library' in Google Drive.</div>`;
          return;
        }
        grid.innerHTML = books.map(b => `
          <div class="p-3 bg-white border border-slate-200 rounded-lg shadow-sm hover:border-indigo-300 flex justify-between items-center">
            <div class="truncate pr-2"><h4 class="text-xs font-bold text-slate-800 truncate">${b.name}</h4><span class="text-[9px] text-slate-400">${b.size}</span></div>
            <a href="${b.url}" target="_blank" class="text-indigo-600 font-bold text-xs">Read ↗</a>
          </div>`).join('');
      }).fetchLibraryBooks();
    }
  </script>
</body>
</html>
